{
  "name": "oneoff-api",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node src/localhost.ts",
    "start": "ts-node src/localhost.ts",
    "deploy:dev": "export $(cat .env.dev | grep -v '^#' | xargs) && serverless deploy --stage dev",
    "docker:test:up": "docker compose up -d",
    "docker:test:down": "docker compose down",
    "test": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5433/testdb jest --runInBand",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "generate:types": "cd packages/types && npm run generate",
    "build:types": "cd packages/types && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "^3.1000.0",
    "@aws-sdk/client-rekognition": "^3.962.0",
    "@aws-sdk/client-s3": "^3.821.0",
    "@aws-sdk/client-secrets-manager": "^3.821.0",
    "@aws-sdk/s3-request-presigner": "^3.966.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "express": "4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "mediainfo.js": "^0.3.7",
    "multer": "^2.0.0",
    "pg": "^8.16.3",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/aws-lambda": "^8.10.150",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "20.12.12",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "@vendia/serverless-express": "^4.12.6",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.5",
    "eslint": "^9.21.0",
    "eslint-plugin-jest": "^28.11.0",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.3",
    "prisma": "^7.0.0",
    "prisma-json-schema-generator": "^5.1.5",
    "serverless": "^3.40.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-esbuild": "^1.55.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "10.9.2",
    "typescript": "5.4.5",
    "typescript-eslint": "^8.25.0"
  }
}
