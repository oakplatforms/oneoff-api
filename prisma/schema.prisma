generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.0.x", "rhel-openssl-1.0.x"]
}

generator json {
  provider = "prisma-json-schema-generator"
  output = "../src/generated/json"
  keepRelationScalarFields = "true"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum EntityType {
  PRODUCT
  SERVICE
  CONTENT
}

enum ProductType {
  CARD
}

enum ListType {
  COLLECTION
  DECK
  FAVORITE
}

enum AccountType {
  REGISTERED
  CUSTOMER
  SELLER
}

enum AdminType {
  MARKET_MANAGER
  BRAND_MANAGER
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
}

enum Status {
  ACTIVE
  DELETED
  INACTIVE
}

enum ProcessStatus {
  COMPLETED
  PENDING
  CANCELED
  FAILED
}

enum TransactionType {
  ORDER_PAYMENT
  ORDER_REFUND
  PAYOUT
}

enum PaymentAccountType {
  STRIPE
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
  APPLE_PAY
}

enum Currency {
  USD
  EUR
  CAD
}

enum ShippingCarrierType {
  USPS
  UPS
  FEDEX
  DHL
}

enum ShippingPackageType {
  ENVELOPE
  BOX
}

enum ShippingServiceType {
  FLAT_RATE
  ECONOMY
  GROUND
  FIRST_CLASS
  PRIORITY
  EXPRESS
  OVERNIGHT
}

enum Size {
  EXTRA_SMALL
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum Condition {
  MINT
  NEAR_MINT
  VERY_GOOD
  GOOD
  FAIR
  POOR
  DAMAGED
}

model User {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  // custom
  authId        String
  isAdmin       Boolean? @default(false)

  // relations
  account       Account?
  admin         Admin?
}

model Admin {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  // custom
  email         String?

  // relations
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String  @unique

  // created by and last modified by relations
  createdBrands  Brand[] @relation(name: "CreatedBy")
  lastModifiedBrands Brand[] @relation(name: "LastModifiedBy")
  createdThemes Theme[] @relation(name: "CreatedBy")
  lastModifiedThemes Theme[] @relation(name: "LastModifiedBy")
  createdCategories Category[] @relation(name: "CreatedBy")
  lastModifiedCategories Category[] @relation(name: "LastModifiedBy")
  createdTags   Tag[] @relation(name: "CreatedBy")
  lastModifiedTags Tag[] @relation(name: "LastModifiedBy")
  createdSupportedTagValues SupportedTagValue[] @relation(name: "CreatedBy")
  lastModifiedSupportedTagValues SupportedTagValue[] @relation(name: "LastModifiedBy")
  createdEntities Entity[] @relation(name: "CreatedBy")
  lastModifiedEntities Entity[] @relation(name: "LastModifiedBy")
  createdShippingMethods ShippingMethod[] @relation(name: "CreatedBy")
  lastModifiedShippingMethods ShippingMethod[] @relation(name: "LastModifiedBy")
  createdShippingOptions ShippingOption[] @relation(name: "CreatedBy")
  lastModifiedShippingOptions ShippingOption[] @relation(name: "LastModifiedBy")
}

model Account {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  // custom
  type          AccountType @default(REGISTERED)
  email         String?

  // relations
  seller        Seller?
  customer      Customer?
  profile       Profile?
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String  @unique
  lists List[]
  reviews Review[]
  bids Bid[]
  listings Listing[]
  payouts Payout[]
  transactions Transaction[]
  shipments Shipment[]

  // order relations
  createdOrders Order[] @relation(name: "CreatedBy")
  purchasedOrders Order[] @relation(name: "PurchasedBy")
  soldOrders     Order[] @relation(name: "SoldBy")
}

model Customer {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  paymentAccountId  String? @unique
  paymentAccountType PaymentAccountType @default(STRIPE)
  paymentAccountStatus ProcessStatus?
  hasPaymentMethod Boolean? @default(false)

  firstName     String?
  lastName      String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?

  // relations
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String  @unique
}

model Seller {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  paymentAccountId  String? @unique
  paymentAccountType PaymentAccountType @default(STRIPE)
  paymentAccountStatus ProcessStatus?
  isPaymentAccountVerified Boolean? @default(false)
  hasPaymentMethod Boolean? @default(false)
  sellerType SellerType?

  firstName     String?
  lastName      String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  businessName  String?
  website       String?

  // relations
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String  @unique
  sellerShippingMethods SellerShippingMethod[]
  sellerShippingOptions SellerShippingOption[]
  shippingCarrierTypes ShippingCarrierType[]
}

model Profile {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // custom
  username      String? @unique
  image         String?
  qrCode        String?

  // relations
  account       Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String?  @unique
}

model Brand {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique
  displayName      String?

  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  theme            Theme?
  entities         Entity[]
}

model Theme {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  logo             String?
  primaryColor     String?
  secondaryColor   String?

  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  brand            Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId          String  @unique
}

model Category {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique 
  displayName      String?
  description      String?

  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  entities         Entity[]
}

model ShippingMethod {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String
  displayName      String?
  description      String?
  size             Size? @default(SMALL)
  shippingPackageType ShippingPackageType @default(ENVELOPE)
  shippingServiceType ShippingServiceType @default(ECONOMY)

  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  shippingOptions  ShippingOption[]
  sellerShippingMethods SellerShippingMethod[]
  bidShippingMethods BidShippingMethod[]
}

model ShippingOption {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String
  displayName      String?
  description      String?
  maxQuantity      Int?
  maxWeight        Float?
  rate             Decimal @db.Decimal(10, 2)
  isStandalone     Boolean? @default(false)

  // relations
  createdBy         Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById       String?
  lastModifiedBy    Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById  String?
  shippingMethod    ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)
  shippingMethodId  String?
  sellerShippingOptions SellerShippingOption[]
  bidShippingOptions BidShippingOption[]
}

model Tag {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique
  displayName      String?
  
  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  entityTags       EntityTag[]
  supportedTagValues SupportedTagValue[]
}

model SupportedTagValue {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String
  displayName      String?
  
  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  tag              Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId            String
}

model List {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String
  displayName      String?
  description      String?
  type             ListType?

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
}

model Entity {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String
  displayName      String?
  description      String?
  type             EntityType @default(PRODUCT)
  image            String?

  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId       String?
  brand            Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId          String?
  product          Product?
  entityTags       EntityTag[]
  reviews          Review[]
  bids             Bid[]
  listings         Listing[]
}

model EntityTag {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tagValue         String
  isPrimary        Boolean?
  index            Int?

  // relations
  tag              Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId            String
  entity           Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId         String
}

model Product {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  type             ProductType @default(CARD)
  releaseDate      DateTime?
  weight           Float?
  sku              String?
  number           String?

  // relations
  entity           Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId         String  @unique
}

model Review {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  rating           Float
  description      String

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
  entity           Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId         String
}

model Payout {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  status           ProcessStatus
  total            Decimal? @db.Decimal(10, 2)
  last4            String? 

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
  transactions     Transaction[]
}

model Listing {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  price            Decimal @db.Decimal(10, 2)
  quantity         Int
  status           Status
  multiTransactionsEnabled Boolean @default(false) 
  condition        Condition @default(MINT)
  isPrimary        Boolean? @default(false)

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
  entity           Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  entityId         String?
  orderListings    OrderListing[]
}

model Bid {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  price            Decimal @db.Decimal(10, 2)
  quantity         Int
  status           Status
  multiTransactionsEnabled Boolean? @default(false) 
  condition        Condition @default(MINT)

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
  entity           Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  entityId         String?
  orderBids        OrderBid[]
  bidShippingMethods BidShippingMethod[]
  bidShippingOptions BidShippingOption[]
}

model Invoice {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  status           Status @default(ACTIVE)

  // relations
  orders           Order[]
}

model Order {
  id               String  @id @default(cuid()) 
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())

  // custom
  status           ProcessStatus
  subTotal         Decimal? @db.Decimal(10, 2)
  taxRate          Decimal? @db.Decimal(10, 2)
  tax              Decimal? @db.Decimal(10, 2)
  total            Decimal? @db.Decimal(10, 2)

  // account
  createdBy        Account? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  purchasedBy      Account? @relation(name: "PurchasedBy", fields: [purchasedById], references: [id], onDelete: SetNull)
  purchasedById    String?
  soldBy           Account? @relation(name: "SoldBy", fields: [soldById], references: [id], onDelete: SetNull)
  soldById         String?
  
  // relations
  transactions     Transaction[]
  shipment         Shipment?
  invoice          Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId        String
  orderBids        OrderBid[]
  orderListings    OrderListing[]
}

model OrderListing {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // relations
  order            Order @relation(fields: [orderId], references: [id])
  orderId          String
  listing          Listing @relation(fields: [listingId], references: [id])
  listingId        String

  @@id([orderId, listingId])
}

model OrderBid {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

    // relations
  order            Order @relation(fields: [orderId], references: [id])
  orderId          String
  bid              Bid @relation(fields: [bidId], references: [id])
  bidId            String

  @@id([orderId, bidId])
}

model Transaction {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  amount           Decimal @db.Decimal(10, 2)
  refundedAmount   Decimal? @db.Decimal(10, 2)
  transactionType  TransactionType @default(ORDER_PAYMENT)
  description      String?
  currency         Currency @default(USD)

  paymentId        String?
  paymentAccountType PaymentAccountType @default(STRIPE)
  paymentMethodType PaymentMethodType @default(CARD)

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
  order            Order? @relation(fields: [orderId], references: [id])
  orderId          String?
  payout           Payout? @relation(fields: [payoutId], references: [id])
  payoutId         String?
}

model SellerShippingMethod {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // relations
  seller           Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId         String
  shippingMethod   ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)
  shippingMethodId String

  @@id([sellerId, shippingMethodId])
}

model SellerShippingOption {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // relations
  seller           Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId         String
  shippingOption   ShippingOption @relation(fields: [shippingOptionId], references: [id], onDelete: Cascade)
  shippingOptionId String

  @@id([sellerId, shippingOptionId])
}

model BidShippingMethod {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // relations
  bid              Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)
  bidId            String
  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)
  shippingMethodId String

  @@id([bidId, shippingMethodId])
}

model BidShippingOption {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // relations
  bid              Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)
  bidId            String
  shippingOption   ShippingOption @relation(fields: [shippingOptionId], references: [id], onDelete: Cascade)
  shippingOptionId String

  @@id([bidId, shippingOptionId])
}

model Shipment {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  fee              Decimal? @db.Decimal(10, 2)
  trackingNumber   String?

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
  order            Order @relation(fields: [transactionId], references: [id])
  transactionId    String  @unique
}
