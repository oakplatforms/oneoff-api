generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.0.x", "rhel-openssl-1.0.x"]
}

generator json {
  provider = "prisma-json-schema-generator"
  output = "../src/generated/json"
  keepRelationScalarFields = "true"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum ProductType {
  CARD
}

enum CollectionType {
  SET
  DECK
}

enum Status {
  ACTIVE
  INACTIVE
  DELETED
}

model User {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  // custom
  cognitoId     String
  
  // relations
  account          Account?
}

model Account {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  // custom
  username      String? @unique
  phone         String?
  email         String?
  firstName     String?
  lastName      String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  
  // relations
  user             User @relation(fields: [userId], references: [id])
  userId           String  @unique
}

model Marketplace {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique
  displayName      String?

  // relations
  theme            Theme?
  brands           Brand[]
  categories       Category[]
  tags             Tag[]
}

model Brand {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique
  displayName      String?

  // relations
  marketplace      Marketplace?  @relation(fields: [marketplaceName], references: [name])
  marketplaceName  String?
  theme            Theme?
  brandCategories  BrandCategory[]
}

model Theme {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  logo             String?
  primaryColor     String?
  secondaryColor   String?

  // relations
  marketplace      Marketplace @relation(fields: [marketplaceId], references: [id])
  marketplaceId    String  @unique
  brand            Brand @relation(fields: [brandId], references: [id])
  brandId          String  @unique
}

model Category {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique
  displayName      String?

  // relations
  marketplace      Marketplace?  @relation(fields: [marketplaceName], references: [name])
  marketplaceName  String?
  brandCategories  BrandCategory[]
}

model Tag {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique // Rarity
  displayName      String?
  
  // relations
  marketplace      Marketplace?  @relation(fields: [marketplaceName], references: [name])
  marketplaceName  String?
  productTags      ProductTag[]
  supportedTagValues SupportedTagValues[]
}

model SupportedTagValues {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String
  displayName      String?
  
  // relations
  tag              Tag @relation(fields: [tagName], references: [id])
  tagName          String
}

model ProductTag {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tagValue         String

  // relations
  tag              Tag @relation(fields: [tagName], references: [name])
  tagName          String
  product          Product @relation(fields: [productId], references: [id])
  productId        String

  @@id([tagName, productId])
}

model BrandCategory {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // relations
  brand            Brand @relation(fields: [brandName], references: [name])
  brandName        String
  category         Category @relation(fields: [categoryName], references: [name])
  categoryName     String
  collections      Collection[]
  products         Product[]
  cards            Card[]

  @@id([brandName, categoryName])
}

model Collection {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  displayName      String?
  name             String?
  description      String?
  type             CollectionType

  // relations
  brandCategory    BrandCategory @relation(fields: [brandCategoryId], references: [id])
  brandCategoryId  String
  products         Product[]
}

model Product {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  displayName      String?
  name             String?
  description      String?
  type             ProductType
  image            String?
  price            String?
  releaseDate      DateTime?

  // relations
  brandCategory    BrandCategory @relation(fields: [brandCategoryId], references: [id])
  brandCategoryId  String
  collection       Collection? @relation(fields: [collectionId], references: [id])
  collectionId     String?
  productTags      ProductTag[]
  card             Card?
}

model Card {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
	number           String?
	shippingCategory String?

  // relations
  brandCategory    BrandCategory @relation(fields: [brandCategoryId], references: [id])
  brandCategoryId  String
  product          Product @relation(fields: [productId], references: [id])
  productId        String  @unique
}