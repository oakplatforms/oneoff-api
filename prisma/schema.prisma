generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum TcgName {
  ONE_PIECE
  POKEMON
}

enum CategoryType {
  TCG
}

enum ProductType {
  CARD
}

enum ColorType {
  RED
  BLUE
  PURPLE
  GREY
  YELLOW
  GREEN
}

model Marketplace {
  id            String  @id @unique @default(cuid()) 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  name          String  @unique
  displayName   String?

  // relations
  theme         Theme?
  brands        Brand[]
  categories    Category[]
}

model Theme {
  id             String  @id @unique @default(cuid()) 
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // custom
  logo           String?
  primaryColor   String?
  secondaryColor String?
  fontFamily     String?

  // relations
  marketplace    Marketplace @relation(fields: [marketplaceId], references: [id])
  marketplaceId  String  @unique
  brand          Brand @relation(fields: [brandId], references: [id])
  brandId        String  @unique
}

model Brand {
  id              String  @id @unique @default(cuid()) 
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  name            String  @unique
  displayName     String?

  // relations
  marketplace     Marketplace?  @relation(fields: [marketplaceName], references: [name])
  marketplaceName String?
  theme           Theme?
  brandCategories BrandCategory[]
}

model Category {
  id            String  @id @unique @default(cuid()) 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  name          String  @unique
  displayName   String?

  // custom
  type          CategoryType @default(TCG)

  // relations
  marketplace     Marketplace?  @relation(fields: [marketplaceName], references: [name])
  marketplaceName String?
  brandCategories BrandCategory[]
}

model BrandCategory {
  id             String  @unique @default(cuid()) 
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  name           String?
  displayName    String?

  // relations
  brand          Brand @relation(fields: [brandName], references: [name])
  brandName      String
  category       Category @relation(fields: [categoryName], references: [name])
  categoryName   String
  sets           Set[]
  products       Product[]
  cards          Card[]

  @@id([brandName, categoryName])
}

model Set {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  displayName      String?
  name             String?
  description      String?

  // relations
  brandCategory    BrandCategory @relation(fields: [brandCategoryId], references: [id])
  brandCategoryId  String
  products         Product[]
}

model Product {
  id            String  @id @default(cuid()) 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  displayName   String?
  name          String?
  description   String?

  // custom
  type             ProductType
  sku              Int
  productImage     String?
  price            String?
  releaseDate      DateTime?
  color            ColorType?
  counter          Int?  @default(0)

  // relations
  brandCategory    BrandCategory @relation(fields: [brandCategoryId], references: [id])
  brandCategoryId  String
  set              Set?  @relation(fields: [setId], references: [id])
  setId            String?
  card             Card?
}

model Card {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  displayName      String?
  name             String?

  // custom
  number           String?
  rarity           String?
  power            Int?
  attribute        String?
  life             Int?
  printing         String?
  art              String?
  artist           String?
  effect           String?

  // relations
  brandCategory    BrandCategory @relation(fields: [brandCategoryId], references: [id])
  brandCategoryId  String
  product          Product @relation(fields: [productId], references: [id])
  productId        String  @unique
}