generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum TcgName {
  ONE_PIECE
}

enum CollectionType {
  STRAW_HAT_CREW
  SUPERNOVAS
}

enum ProductType {
  CARD
}

model Tcg {
  id            String  @id @unique @default(cuid()) 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  name          String  @unique
  displayName   String?
  type          TcgName  @default(ONE_PIECE)
  
  // relations
  collections   Collection[]
  decks         Deck[] 
  products      Product[]  
  cards         Card[]
}

model Collection {
  id            String  @id @default(cuid()) 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  displayName   String?
  name          String?
  description   String?

  // custom
  type          CollectionType

  // relations
  tcg           Tcg?  @relation(fields: [tcgName], references: [name])
  tcgName       String?
  products      Product[]
}

model Deck {
  id            String  @id @default(cuid()) 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  displayName   String?
  name          String?
  description   String?

  // relations
  tcg           Tcg?  @relation(fields: [tcgName], references: [name])
  tcgName       String?
  products      Product[]
}

model Product {
  id            String  @id @default(cuid()) 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  displayName   String?
  name          String?
  description   String?

  // custom
  type          ProductType
  sku           Int

  // relations
  tcg            Tcg?  @relation(fields: [tcgName], references: [name])
  tcgName        String?
  deck           Deck?  @relation(fields: [deckId], references: [id])
  deckId         String?
  collection     Collection?  @relation(fields: [collectionId], references: [id])
  collectionId   String?
  card           Card?
}

model Card {
  id            String  @id @default(cuid()) 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  displayName   String?
  name          String?
  description   String?

  // custom
  counter       Int?  @default(0)
  rarity        String?
  releaseDate   DateTime?

  // relations
  tcg            Tcg?  @relation(fields: [tcgName], references: [name])
  tcgName        String?
  product        Product @relation(fields: [productId], references: [id])
  productId      String  @unique
}