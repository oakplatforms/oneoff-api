generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.0.x", "rhel-openssl-1.0.x"]
}

generator json {
  provider = "prisma-json-schema-generator"
  output = "../src/generated/json"
  keepRelationScalarFields = "true"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum EntityType {
  PRODUCT
  SERVICE
  CONTENT
  EVENT
}

enum ProductType {
  CARD
}

enum ListType {
  DEFAULT
  COLLECTION
  DECK
}

enum AccountType {
  REGISTERED
  CUSTOMER
  SELLER
}

enum AdminType {
  MARKET_MANAGER
  BRAND_MANAGER
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
}

enum Status {
  ACTIVE
  DELETED
  INACTIVE
}

enum ProcessStatus {
  CREATED
  DELETED
  PENDING
  COMPLETED
  CANCELED
  FAILED
}

enum TransactionType {
  PAYMENT
  REFUND
  PAYOUT
}

enum PaymentAccountType {
  STRIPE
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
  APPLE_PAY
}

enum Currency {
  USD
  EUR
  CAD
}

enum ShippingCarrierType {
  USPS
  UPS
  FEDEX
  DHL
}

enum ShippingPackageType {
  ENVELOPE
  BUBBLE_MAILER
  BOX
}

enum ShippingServiceType {
  STANDARD
  GROUND
  PRIORITY
  EXPRESS
}

enum ShipmentAccountType {
  EASY_POST
}

enum ShipmentType {
  OUTBOUND
  RETURN
}

enum Condition {
  MINT
  NEAR_MINT
  VERY_GOOD
  GOOD
  FAIR
  POOR
  DAMAGED
}

model User {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  // custom
  authId        String
  isAdmin       Boolean? @default(false)

  // relations
  account       Account?
  admin         Admin?
}

model Admin {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  // custom
  email         String?

  // relations
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String  @unique

  // created by and last modified by relations
  createdBrands  Brand[] @relation(name: "CreatedBy")
  lastModifiedBrands Brand[] @relation(name: "LastModifiedBy")
  createdThemes Theme[] @relation(name: "CreatedBy")
  lastModifiedThemes Theme[] @relation(name: "LastModifiedBy")
  createdCategories Category[] @relation(name: "CreatedBy")
  lastModifiedCategories Category[] @relation(name: "LastModifiedBy")
  createdTags   Tag[] @relation(name: "CreatedBy")
  lastModifiedTags Tag[] @relation(name: "LastModifiedBy")
  createdSupportedTagValues SupportedTagValue[] @relation(name: "CreatedBy")
  lastModifiedSupportedTagValues SupportedTagValue[] @relation(name: "LastModifiedBy")
  createdEntities Entity[] @relation(name: "CreatedBy")
  lastModifiedEntities Entity[] @relation(name: "LastModifiedBy")
  createdShippingMethods ShippingMethod[] @relation(name: "CreatedBy")
  lastModifiedShippingMethods ShippingMethod[] @relation(name: "LastModifiedBy")
  createdShippingOptions ShippingOption[] @relation(name: "CreatedBy")
  lastModifiedShippingOptions ShippingOption[] @relation(name: "LastModifiedBy")
}

model Account {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  // custom
  type          AccountType @default(REGISTERED)
  email         String?

  // relations
  carts         Cart[]
  seller        Seller?
  customer      Customer?
  profile       Profile?
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String  @unique
  lists List[]
  reviews Review[]
  bids Bid[]
  listings Listing[]
  payouts Payout[]
  transactions Transaction[]
}

model Cart {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  isPrimary     Boolean? @default(false)

  // relations
  account       Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String?
  orders        Order[]
}

model Customer {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  paymentAccountId  String? @unique
  paymentAccountType PaymentAccountType @default(STRIPE)
  paymentAccountStatus ProcessStatus?
  hasPaymentMethod Boolean? @default(false)

  firstName     String?
  lastName      String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?

  // relations
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String  @unique
  orders    Order[]
}

model Seller {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  paymentAccountId  String? @unique
  paymentAccountType PaymentAccountType @default(STRIPE)
  paymentAccountStatus ProcessStatus?
  isPaymentAccountVerified Boolean? @default(false)
  hasPaymentMethod Boolean? @default(false)
  sellerType SellerType?

  firstName     String?
  lastName      String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  businessName  String?
  website       String?

  // relations
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String  @unique
  sellerShippingMethods SellerShippingMethod[]
  sellerShippingOptions SellerShippingOption[]
  shippingCarrierTypes ShippingCarrierType[]
  orders    Order[]
}

model Profile {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // custom
  username      String? @unique
  image         String?
  qrCode        String?

  // relations
  account       Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId     String?  @unique
}

model Brand {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique
  displayName      String?

  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  theme            Theme?
  entities         Entity[]
}

model Theme {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  logo             String?
  primaryColor     String?
  secondaryColor   String?

  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  brand            Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId          String  @unique
}

model Category {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique 
  displayName      String?
  description      String?

  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  entities         Entity[]
}

model ShippingMethod {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String
  displayName      String?
  description      String?
  height           Float?
  length           Float?
  width            Float?
  maxQuantity      Int?
  shippingPackageType ShippingPackageType @default(ENVELOPE)
  shippingServiceType ShippingServiceType @default(STANDARD)

  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  shippingOptions  ShippingOption[]
  sellerShippingMethods SellerShippingMethod[]
  shipments Shipment[]
}

model ShippingOption {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String
  displayName      String?
  description      String?
  weight           Float?
  rate             Decimal @db.Decimal(10, 2)
  isStandalone     Boolean? @default(false)
  maxQuantity      Int?

  // relations
  createdBy         Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById       String?
  lastModifiedBy    Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById  String?
  shippingMethod    ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)
  shippingMethodId  String?
  sellerShippingOptions SellerShippingOption[]
  shipmentShippingOptions ShipmentShippingOption[]
}

model Tag {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique
  displayName      String?
  
  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  entityTags       EntityTag[]
  supportedTagValues SupportedTagValue[]
}

model SupportedTagValue {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String
  displayName      String?
  
  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  tag              Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId            String
}

model List {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String
  displayName      String?
  description      String?
  type             ListType? @default(DEFAULT)

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
  entityList       EntityList[]
}

model Entity {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String
  displayName      String?
  description      String?
  type             EntityType @default(PRODUCT)
  image            String?

  // relations
  createdBy        Admin? @relation(name: "CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      String?
  lastModifiedBy   Admin? @relation(name: "LastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  lastModifiedById String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId       String?
  brand            Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId          String?
  product          Product?
  entityTags       EntityTag[]
  entityList       EntityList[]
  reviews          Review[]
  bids             Bid[]
  listings         Listing[]
}

model EntityList {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // relations
  list             List @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId           String
  entity           Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId         String
}

model EntityTag {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tagValue         String
  isPrimary        Boolean?
  index            Int?

  // relations
  tag              Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId            String
  entity           Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId         String
}

model Product {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  type             ProductType @default(CARD)
  releaseDate      DateTime?
  weight           Float?
  width            Float?
  length           Float?
  height           Float?
  sku              String?
  number           String?

  // relations
  entity           Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId         String  @unique
}

model Review {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  rating           Float
  description      String

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
  entity           Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId         String
}

model Payout {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  status           ProcessStatus
  total            Decimal? @db.Decimal(10, 2)
  last4            String? 

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
  transactions     Transaction[]
}

model Listing {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  price            Decimal @db.Decimal(10, 2)
  quantity         Int
  status           Status
  multiTransactionsEnabled Boolean @default(false) 
  condition        Condition @default(MINT)
  isPrimary        Boolean? @default(false)

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
  entity           Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  entityId         String?
  orderListings    OrderListing[]
}

model Bid {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  price            Decimal @db.Decimal(10, 2)
  quantity         Int
  status           Status
  multiTransactionsEnabled Boolean? @default(false) 
  condition        Condition @default(MINT)

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
  entity           Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  entityId         String?
}

model Invoice {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  status           Status @default(ACTIVE)

  // relations
  orders           Order[]
}

model Order {
  id               String  @id @default(cuid()) 
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())

  // custom
  status           ProcessStatus
  subTotal         Decimal? @db.Decimal(10, 2)
  taxRate          Decimal? @db.Decimal(10, 2)
  tax              Decimal? @db.Decimal(10, 2)
  total            Decimal? @db.Decimal(10, 2)

  // relations
  cart             Cart? @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId           String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId       String?
  seller           Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sellerId         String?
  transactions     Transaction[]
  shipments        Shipment[]
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId        String?
  orderListings    OrderListing[]
}

model OrderListing {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  quantity         Int?

  // relations
  order            Order @relation(fields: [orderId], references: [id])
  orderId          String
  listing          Listing @relation(fields: [listingId], references: [id])
  listingId        String

  @@id([orderId, listingId])
}

model Transaction {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  amount           Decimal @db.Decimal(10, 2)
  refundedAmount   Decimal? @db.Decimal(10, 2)
  transactionType  TransactionType @default(PAYMENT)
  description      String?
  currency         Currency @default(USD)

  paymentId        String?
  paymentAccountType PaymentAccountType @default(STRIPE)
  paymentMethodType PaymentMethodType @default(CARD)

  // relations
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId        String?
  order            Order? @relation(fields: [orderId], references: [id])
  orderId          String?
  payout           Payout? @relation(fields: [payoutId], references: [id])
  payoutId         String?
}

model SellerShippingMethod {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // relations
  seller           Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId         String
  shippingMethod   ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)
  shippingMethodId String

  @@id([sellerId, shippingMethodId])
}

model SellerShippingOption {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // relations
  seller           Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId         String
  shippingOption   ShippingOption @relation(fields: [shippingOptionId], references: [id], onDelete: Cascade)
  shippingOptionId String

  @@id([sellerId, shippingOptionId])
}

model Shipment {
  id                 String  @id @default(cuid()) 
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // custom
  type                ShipmentType @default(OUTBOUND)
  shipmentAccountType ShipmentAccountType @default(EASY_POST)
  status              ProcessStatus
  rate                Decimal @db.Decimal(10, 2)
  externalShipmentId  String?

  // relations
  order              Order? @relation(fields: [orderId], references: [id])
  orderId            String?  @unique
  shippingMethod     ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  shippingMethodId   String?
  shipmentShippingOptions ShipmentShippingOption[]
}

model ShipmentShippingOption {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // relations
  shipment         Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId       String
  shippingOption   ShippingOption @relation(fields: [shippingOptionId], references: [id], onDelete: Cascade)
  shippingOptionId String

  @@id([shipmentId, shippingOptionId])
}
