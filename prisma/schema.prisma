generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

generator json {
  provider                 = "prisma-json-schema-generator"
  output                   = "../src/generated/json"
  keepRelationScalarFields = "true"
}

datasource db {
  provider = "postgresql"
}

enum EntityType {
  PRODUCT
  SERVICE
  CONTENT
  EVENT
}

enum AccountType {
  REGISTERED
  CUSTOMER
  SELLER
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
}

enum Status {
  ACTIVE
  DELETED
  INACTIVE
}

enum ProcessStatus {
  CREATED
  DELETED
  PENDING
  COMPLETED
  CANCELED
  FAILED
  IN_REVIEW
}

enum TransactionType {
  PAYMENT
  REFUND
  PAYOUT
}

enum PaymentAccountType {
  STRIPE
}

enum Currency {
  USD
  EUR
  CAD
}

enum ContentType {
  IMAGE
  VIDEO
}

enum ListType {
  HOMEPAGE
  COLLECTION
  FAVORITE
  CUSTOM
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    Status   @default(ACTIVE)

  // custom
  authId  String
  isAdmin Boolean? @default(false)

  // relations
  account Account?

  @@index([authId])
  @@index([status])
}

model Account {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    Status   @default(ACTIVE)

  // custom
  type  AccountType @default(REGISTERED)
  email String?     @unique

  // relations
  seller       Seller?
  customer     Customer?
  profile      Profile?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String        @unique
  lists        List[]
  listings     Listing[]
  payouts      Payout[]
  transactions Transaction[]
  carts        Cart[]

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([type, status])
  @@index([userId, type])
}

model Customer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    Status   @default(ACTIVE)

  paymentAccountId     String?            @unique
  paymentAccountType   PaymentAccountType @default(STRIPE)
  paymentAccountStatus ProcessStatus?
  hasPaymentMethod     Boolean?           @default(false)

  firstName String?
  lastName  String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?

  // relations
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @unique
  orders    Order[]

  @@index([accountId])
  @@index([status])
  @@index([accountId, status])
}

model Cart {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    Status   @default(ACTIVE)

  // relations
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  orders    Order[]

  @@index([accountId])
  @@index([status])
}

model Seller {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    Status   @default(ACTIVE)

  paymentAccountId         String?            @unique
  paymentAccountType       PaymentAccountType @default(STRIPE)
  paymentAccountStatus     ProcessStatus?
  isPaymentAccountVerified Boolean?           @default(false)
  hasPaymentMethod         Boolean?           @default(false)
  agreedToTerms            Boolean?           @default(false)
  sellerType               SellerType?
  taxRate                  Decimal?           @db.Decimal(10, 2)

  firstName    String?
  lastName     String?
  phone        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  businessName String?
  website      String?
  image        String?

  // relations
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @unique
  orders    Order[]

  @@index([accountId])
  @@index([status])
}

model Profile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  username    String? @unique
  avatar      String?
  banner      String?
  description String?
  qrCode      String?

  // relations
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String?  @unique

  @@index([accountId])
}

model Category {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  name        String  @unique
  displayName String?
  description String?

  // relations
  entities Entity[]
}

model Tag {
  id        String   @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  name        String  @unique
  displayName String?

  // relations
  entityTags         EntityTag[]
  supportedTagValues SupportedTagValue[]
}

model SupportedTagValue {
  id        String   @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  name        String
  displayName String?
  banner      String?
  logo        String?
  description String?

  // relations
  tag   Tag?    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String?

  @@index([tagId])
}

model List {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  name          String
  displayName   String?
  banner        String?
  logo          String?
  description   String?
  type          ListType? @default(COLLECTION)
  isPrivate     Boolean?  @default(false)
  navigation    Json?
  index         Int?
  referenceCode String?   @unique

  // relations
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId  String?
  entityList EntityList[]

  @@index([accountId])
  @@index([type])
  @@index([isPrivate])
  @@index([referenceCode])
}

model Entity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  name           String
  displayName    String?
  description    String?
  type           EntityType @default(PRODUCT)
  image          String?
  secondaryImage String?

  // relations
  category   Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  content    Content?
  entityTags EntityTag[]
  entityList EntityList[]
  listings   Listing[]

  @@index([name])
  @@index([categoryId])
  @@index([type])
  @@index([categoryId, type])
}

model EntityList {
  id        String   @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  quantity Int?

  // relations
  list     List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId   String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId String

  @@id([listId, entityId])
  @@index([listId])
  @@index([entityId])
}

model EntityTag {
  id        String   @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  tagValue  String
  isPrimary Boolean?
  index     Int?

  // relations
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId    String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId String

  @@index([tagId])
  @@index([entityId])
  @@index([tagValue])
}

model Content {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  type         ContentType @default(IMAGE)
  image        String?
  blurredImage String?

  // relations
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId String @unique
}

model Payout {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  status ProcessStatus
  total  Decimal?      @db.Decimal(10, 2)
  last4  String?

  // relations
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId    String?
  transactions Transaction[]
}

model Listing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  price                    Decimal  @db.Decimal(10, 2)
  quantity                 Int
  status                   Status
  multiTransactionsEnabled Boolean  @default(false)
  isPrimary                Boolean? @default(false)
  isOffer                  Boolean? @default(false)
  image                    String?
  imageCaption             String?
  referenceCode            String?  @unique

  // relations
  account       Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId     String?
  entity        Entity?        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  entityId      String?
  orderListings OrderListing[]

  @@index([accountId])
  @@index([entityId])
  @@index([status])
  @@index([price])
  @@index([status, price])
  @@index([entityId, status])
  @@index([accountId, status])
  @@index([referenceCode])
}

model Invoice {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  status Status @default(ACTIVE)

  // relations
  orders Order[]
}

model Order {
  id          String    @id @default(cuid())
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  // custom
  status           ProcessStatus
  subTotal         Decimal?      @db.Decimal(10, 2)
  tax              Decimal?      @db.Decimal(10, 2)
  shipping         Decimal?      @db.Decimal(10, 2)
  total            Decimal?      @db.Decimal(10, 2)
  paymentIntentId  String?
  inReview         Boolean?      @default(false)
  resolution       String?
  customerSnapshot Json?
  sellerSnapshot   Json?

  // relations
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId    String?
  seller        Seller?        @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sellerId      String?
  cart          Cart?          @relation(fields: [cartId], references: [id])
  cartId        String?
  transactions  Transaction[]
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  invoiceId     String?
  orderListings OrderListing[]

  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([customerId, status])
  @@index([sellerId, status])
}

model OrderListing {
  id        String   @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  quantity Int?
  price    Decimal? @db.Decimal(10, 2)

  // relations
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@id([orderId, listingId])
}

model Transaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // custom
  amount             Decimal            @db.Decimal(10, 2)
  refundedAmount     Decimal?           @db.Decimal(10, 2)
  transactionType    TransactionType    @default(PAYMENT)
  description        String?
  currency           Currency           @default(USD)
  paymentId          String?
  paymentAccountType PaymentAccountType @default(STRIPE)

  // relations
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId String?
  order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?
  payout    Payout?  @relation(fields: [payoutId], references: [id])
  payoutId  String?

  @@index([accountId])
  @@index([orderId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([accountId, transactionType])
  @@index([transactionType, createdAt])
}
