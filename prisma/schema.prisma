generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.0.x", "rhel-openssl-1.0.x"]
}

generator json {
  provider = "prisma-json-schema-generator"
  output = "../src/generated/json"
  keepRelationScalarFields = "true"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum ProductType {
  CARD
}

enum ListType {
  COLLECTION
  SET
  DECK
  FAVORITE
}

enum AccountType {
  STANDARD
  SELLER
}

enum Status {
  ACTIVE
  INACTIVE
  DELETED
}

enum PayoutStatus {
  COMPLETED
  PENDING
  CANCELED
}

enum TransactionStatus {
  COMPLETED
  PENDING
  CANCELED
  REFUNDED
}

enum PaymentProcessingType {
  STRIPE
}

enum PaymentProcessingMethodType {
  CARD
  BANK_ACCOUNT
}

enum DeliveryMethodType {
  FIRST_CLASS_MAIL
  OVERNIGHT
  PRIORITY
  FLAT_RATE
  ECONOMY
  LOCAL_DELIVERY
  IN_PERSON
  INTERNATIONAL
}

model User {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  // custom
  cognitoId     String
  
  // relations
  account       Account?
}

model Account {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        Status @default(ACTIVE)

  // custom
  type          AccountType @default(STANDARD)
  isPremium     Boolean? @default(false)
  phone         String?
  email         String?
  firstName     String?
  lastName      String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  
  // relations
  profile       Profile?
  wallet        Wallet?
  user          User @relation(fields: [userId], references: [id])
  userId        String  @unique
}

model Profile {
  id            String   @id @default(cuid()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // custom
  username      String? @unique
  isPrivate     Boolean? @default(false)
  fullName      String?
  image         String?
  qrCode        String?

  // relations
  account       Account @relation(fields: [accountId], references: [id])
  accountId     String  @unique
  lists         List[]
  reviews       Review[]
  bids          Bid[]
  listings      Listing[]
}

model Marketplace {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique
  displayName      String?

  // relations
  theme            Theme?
  brands           Brand[]
  categories       Category[]
  tags             Tag[]
}

model Brand {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique
  displayName      String?

  // relations
  marketplace      Marketplace?  @relation(fields: [marketplaceName], references: [name])
  marketplaceName  String?
  theme            Theme?
  brandCategories  BrandCategory[]
}

model Theme {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  logo             String?
  primaryColor     String?
  secondaryColor   String?

  // relations
  marketplace      Marketplace @relation(fields: [marketplaceId], references: [id])
  marketplaceId    String  @unique
  brand            Brand @relation(fields: [brandId], references: [id])
  brandId          String  @unique
}

model Category {
  id               String  @id @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique
  displayName      String?

  // relations
  marketplace      Marketplace?  @relation(fields: [marketplaceName], references: [name])
  marketplaceName  String?
  brandCategories  BrandCategory[]
}

model Tag {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String  @unique
  displayName      String?
  
  // relations
  marketplace      Marketplace?  @relation(fields: [marketplaceName], references: [name])
  marketplaceName  String?
  productTags      ProductTag[]
  supportedTagValues SupportedTagValues[]
}

model SupportedTagValues {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  name             String
  displayName      String?
  
  // relations
  tag              Tag @relation(fields: [tagId], references: [id])
  tagId            String
}

model ProductTag {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tagValue         String

  // relations
  tag              Tag @relation(fields: [tagId], references: [id])
  tagId            String
  product          Product @relation(fields: [productId], references: [id])
  productId        String

  @@id([tagId, productId])
}

model BrandCategory {
  id               String  @unique @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // relations
  brand            Brand @relation(fields: [brandName], references: [name])
  brandName        String
  category         Category @relation(fields: [categoryName], references: [name])
  categoryName     String
  lists            List[]
  products         Product[]
  cards            Card[]

  @@id([brandName, categoryName])
}

model List {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  displayName      String?
  name             String?
  description      String?
  type             ListType

  // relations
  brandCategory    BrandCategory @relation(fields: [brandCategoryId], references: [id])
  brandCategoryId  String
  products         Product[]
  profile          Profile? @relation(fields: [profileId], references: [id])
  profileId        String?
}

model Product {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  displayName      String?
  name             String?
  description      String?
  type             ProductType
  image            String?
  price            String?
  releaseDate      DateTime?

  // relations
  brandCategory    BrandCategory @relation(fields: [brandCategoryId], references: [id])
  brandCategoryId  String
  list             List? @relation(fields: [listId], references: [id])
  listId           String?
  productTags      ProductTag[]
  card             Card?
  reviews          Review[]
  bids          Bid[]
  listings      Listing[]
}

model Card {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  number           String?
  shippingCategory String?

  // relations
  brandCategory    BrandCategory @relation(fields: [brandCategoryId], references: [id])
  brandCategoryId  String
  product          Product @relation(fields: [productId], references: [id])
  productId        String  @unique
}

model Review {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  rating           Int?
  description      String?

  // relations
  profile          Profile? @relation(fields: [profileId], references: [id])
  profileId        String?
  product          Product? @relation(fields: [productId], references: [id])
  productId        String?
}

model Wallet {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  paymentProcessingType PaymentProcessingType @default(STRIPE)
  paymentProcessingCustomerId String
  paymentProcessingMethodType PaymentProcessingMethodType @default(CARD)
  paymentProcessingtMethodId  String
  balance          Int?

  // relations
  payouts          Payout[]
  account          Account @relation(fields: [accountId], references: [id])
  accountId        String  @unique
}

model Payout {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  status           PayoutStatus
  paymentProcessingType PaymentProcessingType @default(STRIPE)
  paymentProcessingPayoutId String
  amount           Int

  // relations
  wallet           Wallet? @relation(fields: [walletId], references: [id])
  walletId         String?
}

model Listing {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  amount           Int
  status           Status

  // relations
  profile          Profile? @relation(fields: [profileId], references: [id])
  profileId        String?
  product          Product? @relation(fields: [productId], references: [id])
  productId        String?
  transaction      Transaction?
}

model Bid {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  amount           Int
  status           Status

  // relations
  profile          Profile? @relation(fields: [profileId], references: [id])
  profileId        String?
  product          Product? @relation(fields: [productId], references: [id])
  productId        String?
  transaction      Transaction?
}

model Transaction {
  id               String  @id @default(cuid()) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // custom
  subTotal         Int
  tax              Int?
  total            Int
  status           TransactionStatus
  deliveryMethodType DeliveryMethodType
  trackingNumber   String?

  // relations
  bid              Bid @relation(fields: [bidId], references: [id])
  bidId            String  @unique
  listing          Listing @relation(fields: [listingId], references: [id])
  listingId        String  @unique
}
